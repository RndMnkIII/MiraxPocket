<misterromdescription>
    <about author="RndMnkIII (Javier)" webpage="https://github.com/RndMnkIII" source="MAME misc/mirax.cpp"/>

    <name>Mirax (set 1)</name>
    <setname>mirax</setname>
    <rbf>mirax</rbf>
    <mameversion>0264</mameversion>
    <year>1985</year>
    <manufacturer>Current Technology, Inc.</manufacturer>
    <players>2</players>
    <joystick>4-way</joystick>
    <buttons count="1" default="A" names="Fire"/>
    <region>World</region>
    <rotation>vertical (cw)</rotation>
    <category>Shooter</category>

    <!-- ============================================================
         Single-blob load stream expected by the MiraxCore loader.
         Offsets (bytes):
           0x00000  prog (encrypted, data_code)  0xC000  p5,r5,s5
           0x0C000  audiocpu                      0x2000  mxr2
           0x0E000  tiles  (3 planes 0x4000)      0xC000  e3,h3,k3
           0x1A000  sprites(3 planes 0x8000)      0x18000 f3,e2,i3,f2,l3,h2
           0x32000  color proms                   0x0040  mra3,mrb3
           ------------------------------------------------------------
           total = 0x32040 (205,376 bytes)
         The program is stored AS-IS (encrypted); mirax_decrypt
         descrambles on the bus, so CRCs match the MAME dump.
         ============================================================ -->

    <rom index="0" zip="mirax.zip" md5="none">
        <!-- 0x00000 : main program (encrypted) -->
        <part name="mxp5-42.rom" crc="716410a0"/>
        <part name="mxr5-4v.rom" crc="c9484fc3"/>
        <part name="mxs5-4v.rom" crc="e0085f91"/>
        <!-- 0x0C000 : audio CPU (8K sound ROM) -->
        <part name="mxr2-4v.rom" crc="cd2d52dc"/>
        <!-- 0x0E000 : tiles, plane 0/1/2 -->
        <part name="mxe3-4v.rom" crc="0cede01f"/>
        <part name="mxh3-4v.rom" crc="58221502"/>
        <part name="mxk3-4v.rom" crc="6dbc2961"/>
        <!-- 0x1A000 : sprites, plane 0 (f3+e2), plane 1 (i3+f2), plane 2 (l3+h2) -->
        <part name="mxf3-4v.rom" crc="14b1ca85"/>
        <part name="mxe2-4v.rom" crc="2cf5d8b7"/>
        <part name="mxi3-4v.rom" crc="20fb2099"/>
        <part name="mxf2-4v.rom" crc="1f42c7fa"/>
        <part name="mxl3-4v.rom" crc="918487aa"/>
        <part name="mxh2-4v.rom" crc="cbaff4c6"/>
        <!-- 0x32000 : color PROMs (2x 82S123) -->
        <part name="mra3.prm" crc="ae7e1a63"/>
        <part name="mrb3.prm" crc="e3f3d0f5"/>
    </rom>

    <!-- DSW1 = byte0 (bits 0-7), DSW2 = byte1 (bits 8-15).
         Defaults: DSW1=0x00, DSW2=0x0C (Demo Sounds On + Allow Continue Yes). -->
    <switches default="00,0C" base="0">
        <!-- DSW1 (0xF200) -->
        <dip name="Coinage"       bits="0,1" ids="1C 1C,1C 2C,1C 3C,2C 1C"/>
        <dip name="Cabinet"       bits="2"   ids="Upright,Cocktail"/>
        <dip name="Flip Screen"   bits="3"   ids="Off,On"/>
        <dip name="Lives"         bits="4,5" ids="3,4,5,2"/>
        <!-- DSW2 (0xF400) -->
        <dip name="Bonus Life"    bits="8"   ids="30k 80k 150k,900k 950k 990k"/>
        <dip name="Extra Lives"   bits="9"   ids="5,8"/>
        <dip name="Demo Sounds"   bits="10"  ids="Off,On"/>
        <dip name="Allow Continue" bits="11" ids="No,Yes"/>
        <dip name="Auto-Play Mode" bits="12" ids="No,Yes"/>
        <dip name="Difficulty"    bits="13"  ids="Easy,Hard"/>
    </switches>
</misterromdescription>
